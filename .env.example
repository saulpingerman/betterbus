# Copy to .env (git-ignored) and fill in. Where each key comes from:
# WMATA developer portal, https://developer.wmata.com (Profile, primary key)
WMATA_API_KEY=
WMATA_API_KEY_SECONDARY=
# Mobility Database, https://mobilitydatabase.org (account page, refresh token)
MOBILITY_DB_REFRESH_TOKEN=
# Transitland, https://www.transit.land (API key)
TRANSITLAND_API_KEY=
# NOAA Climate Data Online, https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=
# Census Data API, https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
